# Railway terminates TLS and forwards the original scheme; behind no proxy, $scheme.
map $http_x_forwarded_proto $site_scheme {
    default $scheme;
    https   https;
    http    http;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ---- search indexing: the site's own URL is whatever host serves it ----
    set $site_url "$site_scheme://$host";

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nAllow: /\nDisallow: /downloads/\nSitemap: $site_url/sitemap.xml\n";
    }
    location = /sitemap.xml {
        default_type application/xml;
        return 200 "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url><loc>$site_url/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>\n</urlset>\n";
    }

    # the page's canonical URL, social image and Search Console tag are filled in here,
    # so the HTML never hardcodes a domain. GOOGLE_SITE_VERIFICATION is a Railway variable.
    location = / {
        try_files /index.html =404;
        add_header Link "<$site_url/>; rel=\"canonical\"" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '<link rel="canonical" href="/">' '<link rel="canonical" href="$site_url/">';
        sub_filter 'content="assets/og-image.png?v=0.1.0-8"' 'content="$site_url/assets/og-image.png?v=0.1.0-8"';
        sub_filter '<meta name="google-site-verification" content="">' '<meta name="google-site-verification" content="${GOOGLE_SITE_VERIFICATION}">';
    }
    location = /index.html { return 301 $site_url/; }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # the installer lives on the GitHub release, not in the image: keep the site's own
    # download path working by sending it there
    location = /downloads/AIMaestro-Setup.exe {
        return 302 https://github.com/Awguhst/AI-Maestro-Website/releases/latest/download/AIMaestro-Setup.exe;
    }
    location = /downloads/AIMaestro-Setup-CUDA.exe {
        return 302 https://github.com/Awguhst/AI-Maestro-Website/releases/latest/download/AIMaestro-Setup-CUDA.exe;
    }

    location ~* \.(png|jpg|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
    location ~* \.(css|js)$ {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # the inline script that marks JS as available is allowed by its hash; the inline
    # style attributes are CSS custom properties (--d, --shot-ar), hence unsafe-inline for styles
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
}
